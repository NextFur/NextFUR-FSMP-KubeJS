ServerEvents.recipes(e => {

    e.recipes.createsifter.sifting(
        [
            Output.of("create:crushed_raw_lead", 0.04),
            Output.of("create:crushed_raw_silver", 0.025),
            Output.of("create:crushed_raw_aluminum", 0.025)
        ], "minecraft:gravel", "createsifter:advanced_brass_mesh"
    )

})