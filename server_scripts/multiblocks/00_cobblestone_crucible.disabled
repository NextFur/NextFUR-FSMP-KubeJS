// https://github.com/alec016/modular-machinery-reborn/blob/1.21-NeoForge/kubejsExample/server_scripts/recipes.js


MMREvents.machines(e => {
        
    // Fluid input hatch
    const valid_fih = ['modular_machinery_reborn:fluidinputhatch_small', 'modular_machinery_reborn:fluidinputhatch_reinforced', 'modular_machinery_reborn:fluidinputhatch_huge']

    // Fluid output hatch
    const valid_foh = ['modular_machinery_reborn:fluidoutputhatch_small', 'modular_machinery_reborn:fluidoutputhatch_reinforced', 'modular_machinery_reborn:fluidoutputhatch_huge']

    // Item input bus
    const valid_iib = ['modular_machinery_reborn:inputbus_small', 'modular_machinery_reborn:inputbus_reinforced', 'modular_machinery_reborn:inputbus_huge']

    // Item output bus
    const valid_iob = ['modular_machinery_reborn:outputbus_small', 'modular_machinery_reborn:outputbus_reinforced', 'modular_machinery_reborn:outputbus_huge']

    // Exp input hatch
    const valid_eih = ['modular_machinery_reborn:experienceinputhatch_small', 'modular_machinery_reborn:experienceinputhatch_reinforced', 'modular_machinery_reborn:experienceinputhatch_huge']

    // Exp output hatch
    const valid_eoh = ['modular_machinery_reborn:experienceoutputhatch_small', 'modular_machinery_reborn:experienceoutputhatch_reinforced', 'modular_machinery_reborn:experienceoutputhatch_huge']

    // Durability hatch
    const valid_dh = ['modular_machinery_reborn:durabilityhatch_small', 'modular_machinery_reborn:durabilityhatch_big']


    e.create("mmr:cobblestone_crucible")
        .name("Cobblestone Crucible")
        .color("#FF3B3B3B")
        .structure(
            MMRStructureBuilder.create()
            .pattern([
                ["aaa", "aba", "aaa"],
                ["cmc", "e e", "cdc"],
                ["ccc", "g g", "ccc"],
                [" c ", "ccc", " c "]
            ])
            .keys({
                "a": ["kubejs:treated_casing"],
                "b": ["minecraft:obsidian"],
                "c": ["modular_machinery_reborn:casing_plain"],
                "d": valid_iob,
                "e": valid_fih,
                "g": ["modular_machinery_reborn:casing_vent"],
                // "h": [ "mmrcreate:kinetic_input_hatch_small_slow"]
            }))

        //Testing:
        // .controllerModel(ControllerModel.of("minecraft:furnace"))

})

let h = 96
let w = 192

ServerEvents.recipes(e => {
    e.recipes.modular_machinery_reborn.machine_recipe("mmr:cobblestone_crucible", 100)
        // .requireKinetic(32, 8, h - 8 - 18)
        // motherfucking mod
        .height(h)
        .width(w)
        .progressX((w - 22) / 2)
        .progressY((h - 16) / 2)
        .requireFluid("10x minecraft:water", 8, 8)
        .requireFluid("10x minecraft:lava", 8 + 18, 8)
        .produceItem("64x minecraft:cobblestone", (w - 8) - 18 - 18, 8)
        .produceItem("32x minecraft:cobblestone", 0.5, (w - 8) - 18, 8)
})