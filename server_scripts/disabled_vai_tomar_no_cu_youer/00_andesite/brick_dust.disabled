ServerEvents.recipes(e => {

    // Milling 
    e.custom({
        "type": "create:milling",
        "ingredients": [{ "item": "minecraft:brick" }],
        "processing_time": 50,
        "results": [
            { "id": "kubejs:brick_dust", "count": 1 }
        ]
    })

    e.custom({
        "type": "create:milling",
        "ingredients": [{ "item": "minecraft:brick_slab" }],
        "processing_time": 100,
        "results": [
            { "id": "kubejs:brick_dust", "count": 2 }
        ]
    })

    e.custom({
        "type": "create:milling",
        "ingredients": [{ "item": "minecraft:bricks" }],
        "processing_time": 200,
        "results": [
            { "id": "kubejs:brick_dust", "count": 4 }
        ]
    })

    // Crushing
    e.custom({
        "type": "create:crushing",
        "ingredients": [{ "item": "minecraft:brick" }],
        "processing_time": 50,
        "results": [
            { "count": 1, "id": "kubejs:brick_dust" },
            { "chance": 0.1, "id": "kubejs:brick_dust" }
        ]
    })

    e.custom({
        "type": "create:crushing",
        "ingredients": [{ "item": "minecraft:brick_slab" }],
        "processing_time": 100,
        "results": [
            { "count": 2, "id": "kubejs:brick_dust" },
            { "chance": 0.2, "id": "kubejs:brick_dust" }
        ]
    })

    e.custom({
        "type": "create:crushing",
        "ingredients": [{ "item": "minecraft:bricks" }],
        "processing_time": 200,
        "results": [
            { "count": 4, "id": "kubejs:brick_dust" },
            { "chance": 0.4, "id": "kubejs:brick_dust" }
        ]
    })


})