ServerEvents.recipes(e => {
    
    // Remove Alloy Kiln's recipes
    e.remove({ output: "immersiveengineering:alloybrick" })

    // Add a mixing recipe for them

    e.custom({
        "type": "create:mixing",
        "ingredients": [
            { "type": "neoforge:block_tag", "tag": "minecraft:sand" },
            { "type": "neoforge:block_tag", "tag": "minecraft:sand" },
            { "type": "neoforge:block_tag", "tag": "minecraft:sand" },
            { "type": "neoforge:block_tag", "tag": "minecraft:sand" },
            { "item": "kubejs:brick_dust" }
        ],
        "results": [
            { "id": "immersiveengineering:alloybrick" }
        ]
    })

})