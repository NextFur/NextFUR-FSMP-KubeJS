EntityEvents.beforeHurt("minecraft:spider", e => {
    let spider = e.entity
    let player = e.source.player

    if (!e.source || !e.source.actual || !e.source.player) return
    if (!spider.type.includes("spider")) return

    //let target = e.level.getNearestPlayer(spider, 40)
    let target = player
    spider.lookAt("eyes", new Vec3d(target.x, target.y, target.z))
    // e.server.runCommand(`/execute in ${e.level.dimension} run cast ${spider.uuid} starfall 5`)
    // console.log(spider.yaw)

    let chance = Math.random()
    // if (chance < 0.3) return
    for (let i = 0; i < 10; i++) {
        e.server.scheduleInTicks(1 + i , () => {
            let offset_x = (Math.random() * 3) - 1.5
            let offset_y = (Math.random() * 1) - 0.5
            let offset_z = (Math.random() * 3) - 1.5
            spider.lookAt("eyes", new Vec3d(target.x + offset_x, target.y + offset_y, target.z + offset_z))
            e.server.runCommand(`/execute in ${e.level.dimension} run cast ${spider.uuid} firebolt 5`)
        })
    }

})