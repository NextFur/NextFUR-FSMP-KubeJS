        ("§4§lAdvanced Sturdy Mesh (Brass Sifter)"),
        ("§7- Crushed Raw Lead (12%)"),
        ("§7- Crushed Raw Silver (8%)"),
        ("§7- Ender Pearl (4%)"),
        ("§7- Nugget of Experience (2%)"),
        ("§7- Minitra Geode (<1%)")
    ])
})